# shellcheck disable=SC2034
#
# Staging .env for docker-jitsi-meet, deployed at staging.fortressconferencing.com
# on a single EC2 box. Copy to .env on the box (gitignored) and fill in the
# placeholders. Diffed against local dev's .env -- see inline comments below
# for what changed and why; everything else (XMPP_MODULES, ENABLE_RECORDING,
# JVB_COLIBRI_PORT, LOG_LEVEL) carries over unchanged from local dev.

CONFIG=~/.jitsi-meet-cfg

# Fortress custom Prosody modules loaded on the main XMPP VirtualHost -- see
# resources/prosody-plugins in the Fortress repo. Unchanged from local dev.
XMPP_MODULES=exhibit_viewer_metadata

# CHANGED from local dev (8000/8443): must be the real ports so Let's
# Encrypt's HTTP-01 challenge and normal HTTPS traffic both work from the
# public internet.
HTTP_PORT=80
HTTPS_PORT=443

TZ=UTC

# CHANGED from local dev (https://meet.jitsi:${HTTPS_PORT}): real domain, no
# port suffix since HTTPS_PORT is now the standard 443.
PUBLIC_URL=https://staging.fortressconferencing.com

# CHANGED from local dev (unset, defaults to meet.jitsi everywhere): must be
# explicit. The existing FOR-59 web-service network alias in
# docker-compose.yml already interpolates ${XMPP_DOMAIN:-meet.jitsi}, so
# setting this is the only change needed for Jibri's internal Chrome to
# resolve the real domain inside the Docker network -- no compose-file edit.
XMPP_DOMAIN=staging.fortressconferencing.com

# CHANGED from local dev (127.0.0.1, loopback-only): the box's real public
# IP so JVB advertises a reachable ICE candidate. Use the Elastic IP from
# `terraform output staging_instance_public_ip` -- it stays stable across
# instance stop/start, unlike the default ephemeral public IP.
JVB_ADVERTISE_IPS=REPLACE_WITH_ELASTIC_IP

#
# Let's Encrypt configuration
# CHANGED from local dev (all commented out / disabled): turned on here so
# nginx gets a real trusted cert instead of the self-signed one local dev
# uses (the direct fix for the WebSocket-disconnect issue debugged locally).
#

ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=staging.fortressconferencing.com
LETSENCRYPT_EMAIL=REPLACE_WITH_YOUR_EMAIL

# Uncomment while first verifying the setup end-to-end, to avoid Let's
# Encrypt's production rate limits on repeated test issuances. Comment back
# out (or remove) once confirmed working, since the staging CA's certs
# aren't trusted by browsers.
#LETSENCRYPT_USE_STAGING=1

#
# Security -- passwords
#
# DO NOT reuse local dev's password values. Fill this file in, bring the
# .env over to the box, then immediately run ./gen-passwords.sh against it
# to overwrite these with fresh random ones before first `docker compose up`.
#

JICOFO_AUTH_PASSWORD=REPLACE_RUN_GEN_PASSWORDS_SH
JVB_AUTH_PASSWORD=REPLACE_RUN_GEN_PASSWORDS_SH
JIGASI_XMPP_PASSWORD=REPLACE_RUN_GEN_PASSWORDS_SH
JIGASI_TRANSCRIBER_PASSWORD=REPLACE_RUN_GEN_PASSWORDS_SH
JIBRI_RECORDER_PASSWORD=REPLACE_RUN_GEN_PASSWORDS_SH
JIBRI_XMPP_PASSWORD=REPLACE_RUN_GEN_PASSWORDS_SH

# Fortress FOR-59 end-to-end recording test. Unchanged from local dev.
ENABLE_RECORDING=1

# CHANGED from local dev (1): this was specifically a workaround for the
# self-signed cert on meet.jitsi:8443 causing Chrome's TLS interstitial
# inside Jibri's internal browser. Leave =1 for the very first boot (cert
# isn't issued yet), then unset/comment out once step 2 of the verification
# plan confirms the Let's Encrypt cert is live -- a trusted cert makes this
# workaround unnecessary, and leaving it on masks real cert problems later.
IGNORE_CERTIFICATE_ERRORS=1

JVB_COLIBRI_PORT=8070
LOG_LEVEL=debug
