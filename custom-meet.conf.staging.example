# Staging-only: reverse-proxies exhibit-service under the same domain/cert
# as the rest of the stack, so a second DNS record + second Let's Encrypt
# cert isn't needed. Gets appended verbatim into the rendered meet.conf
# (included inside both the :80 and :443 server blocks) by
# web/rootfs/etc/s6-overlay/scripts/config, which looks for exactly this
# path -- see that script for the mechanism.
#
# Setup on the staging box:
#   mkdir -p ${CONFIG:-~/.jitsi-meet-cfg}/web/nginx
#   cp custom-meet.conf.staging.example ${CONFIG:-~/.jitsi-meet-cfg}/web/nginx/custom-meet.conf
#   docker compose --env-file .env -f docker-compose.yml -f jibri.yml -f exhibit-service.yml -f transcript-service.yml -f staging-gate.yml -f jibri-internal-url.yml restart web
#
# The frontend calls `${apiUrl}/api/exhibits` where apiUrl is
# "https://staging.fortressconferencing.com/exhibit-api" (see
# custom-config.js.staging.example) -- i.e. the actual request path is
# /exhibit-api/api/exhibits, and the /exhibit-api prefix needs to be
# stripped before forwarding so the upstream sees /api/exhibits, matching
# exhibit-service's own route mount (`app.use('/api/exhibits',
# exhibitsRouter)` in src/index.ts) exactly.
#
# The `^~` modifier is required, not optional: stock meet.conf already has a
# regex location (`location ~ ^/([^/?&:'"]+)/(.*)$`) implementing Jitsi's
# tenant-subdomain URL scheme, which matches ANY multi-segment path like
# /exhibit-api/api/exhibits. Nginx always prefers a matching regex location
# over a prefix location, REGARDLESS of the prefix's specificity or where
# either is declared in the file -- without `^~`, every request here gets
# silently captured by that tenant rewrite instead of this proxy block,
# manifesting as a confusing 405 (method-not-allowed on the rewritten SPA
# route) instead of ever reaching exhibit-service. `^~` tells nginx "if this
# prefix is the longest match, stop -- don't consider regex locations at
# all," which is the standard fix for exactly this conflict.
location ^~ /exhibit-api/ {
    # Explicit rewrite+break to strip the /exhibit-api prefix; proxy_pass
    # below has no URI part of its own, so nginx passes the (rewritten)
    # request URI through as-is -- the standard, well-tested pattern for
    # "strip a prefix, then proxy the rest".
    rewrite ^/exhibit-api/(.*)$ /$1 break;

    # Deliberately a STATIC proxy_pass target, not a variable-based one:
    # tried the `set $var; proxy_pass $var...;` form first (intending
    # per-request DNS re-resolution via Docker's embedded resolver, so an
    # exhibit-service container recreate wouldn't also require restarting
    # web) but hit two real nginx quirks in sequence on this build --
    # variable targets silently disable proxy_pass's automatic URI
    # substitution (every request reached the upstream as bare "/"), and
    # even after working around that with the rewrite above, a bare
    # variable target threw "invalid URL prefix" at runtime. Not worth
    # fighting further for a single-instance staging box: exhibit-service
    # rarely gets recreated independent of web, and when it does, restart
    # web too (same as any other config change here).
    proxy_pass http://exhibit-service:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Reverse-proxies identity-service (FOR-50 magic-link login), same
# rationale and rewrite/proxy_pass pattern as /exhibit-api/ above -- see
# that block's comments for the full explanation (^~ precedence, static
# proxy_pass target, prefix-stripping rewrite). The frontend calls
# `${apiUrl}/api/auth/...` etc. where apiUrl is
# "https://staging.fortressconferencing.com/identity-api" (see
# custom-config.js.staging.example), matching identity-service's own route
# mounts (`app.use('/api/auth', ...)` etc. in src/index.ts).
location ^~ /identity-api/ {
    rewrite ^/identity-api/(.*)$ /$1 break;
    proxy_pass http://identity-service:4300;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Reverse-proxies the deposition transcript panel's WebSocket connection to
# transcript-service, same rationale as /exhibit-api/ above (one cert, one
# DNS record). Frontend config sets this exact URL via
# config.transcriptService.wsUrl (custom-config.js.staging.example) --
# without it, transcript/middleware.ts falls back to an insecure
# `ws://...:4100/ws/panel` URL, which browsers refuse to open from an HTTPS
# page (mixed content) and throw a SecurityError. That error was thrown
# synchronously from inside a CONFERENCE_JOINED handler running on
# Strophe's own call stack, which took down Strophe's connection handlers
# entirely -- the actual cause behind "Join meeting turns the button grey
# and never joins", not a join-button bug at all.
#
# ^~ required for the same tenant-subdomain-regex-precedence reason
# documented above. No rewrite needed -- this is a single fixed upstream
# path, not multiple REST routes to preserve.
location ^~ /transcript-ws/panel {
    proxy_pass http://transcript-service:4100/ws/panel;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # WebSocket connections are long-lived; nginx's 60s default proxy
    # timeout would silently kill idle transcript panel connections.
    proxy_read_timeout 3600s;
}

# Reverse-proxies Collabora Online (CODE), which renders Office exhibits --
# especially spreadsheets -- natively in the exhibit viewer instead of as a
# Gotenberg-converted PDF (see collabora.yml for why conversion is destructive
# for a ledger). Same one-cert/one-DNS-record rationale as /exhibit-api/ above.
#
# Unlike the other upstreams here, Collabora is loaded in an IFRAME by each
# participant's browser, so it has to be reachable at the public origin -- it
# cannot live on the internal network only. The frontend builds the iframe URL
# from config.exhibitViewer.collaboraUrl (custom-config.js.staging.example).
#
# NO prefix-stripping rewrite, and that is the important difference from every
# other block in this file. Collabora serves its client from absolute paths of
# its own (/browser/<hash>/..., /cool/...) which it also generates internally
# into the HTML it returns; rewriting the prefix off would make the returned
# page reference paths that don't exist at this origin. So the prefix IS
# /browser and /cool, matching the upstream's real paths one-to-one.
location ^~ /browser/ {
    proxy_pass http://collabora:9980;
    proxy_http_version 1.1;
    # $http_host, NOT $host, for every Collabora block -- $host drops the port, and Collabora
    # builds the WebSocket URL it hands the browser from this header. On a non-default port
    # that produces a socket URL pointing at :80, and the editor fails with "Failed to
    # establish socket connection ... the reverse proxy might be misconfigured" while every
    # static asset loads fine -- a genuinely confusing failure, confirmed by reproducing it.
    # Identical to $host on 443, so this costs nothing and removes the trap.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Suppresses Collabora's welcome screen and its "Your Review Is Our Best Motivation"
    # star-rating survey, both of which otherwise appear modally over the document -- the
    # survey was seen firing mid-session during testing, and a rating dialog on top of an
    # exhibit during testimony is not acceptable.
    #
    # Done here, at the proxy, rather than with coolwsd's own `--o:home_mode.enable=true`.
    # home_mode is the only config switch for these popups (verified: `--o:welcome.enable`
    # has no effect on either flag), but it also caps the WHOLE instance at 20 concurrent
    # connections and 10 concurrent open documents -- confirmed from coolwsd's startup log --
    # and one container serves every room, so those are totals across all depositions. Two
    # simultaneous ten-person depositions would sit exactly at the connection cap.
    #
    # These two attributes on the editor's HTML are precisely what home_mode flips, so
    # rewriting them in flight gets the popups gone while concurrency stays at coolwsd's
    # compiled maximum (1000000). Verified end to end: document loads, chart/formulas/sheet
    # tabs all render, WebSocket connects.
    #
    # Accept-Encoding must be cleared or sub_filter is handed a compressed body it cannot
    # rewrite. That applies to the whole location, and this location also serves the editor's
    # 3.7MB bundle.js -- so nginx re-compresses on the way out rather than sending it plain.
    # Without the gzip line below this block is a real bandwidth regression, not a subtle one.
    #
    # Scoping the rewrite to cool.html alone would be preferable, but its path is
    # build-hashed (/browser/<hash>/cool.html) so it cannot be written as a longer ^~ prefix,
    # and demoting this to a plain prefix to allow a regex location would hand the path back
    # to meet.conf's tenant regex -- see the ^~ explanation on /exhibit-api/ above.
    proxy_set_header Accept-Encoding "";
    gzip on;
    gzip_proxied any;
    # text/html is deliberately absent: nginx always gzips it and rejects it here as a
    # duplicate. Same reason there is no `sub_filter_types` line -- text/html is its default.
    gzip_types text/css application/javascript application/json image/svg+xml;
    sub_filter_once off;
    sub_filter 'data-auto-show-feedback = "true"' 'data-auto-show-feedback = "false"';
    sub_filter 'data-auto-show-welcome = "true"'  'data-auto-show-welcome = "false"';

    # Collabora's static client bundle is fetched by the iframe without the
    # gate cookie being meaningful to it, and a 302 to /gate/ inside an iframe
    # produces a blank exhibit panel with no error. The document itself is
    # still protected -- every byte of every exhibit goes through WOPI, which
    # authenticates the room-scoped access_token independently of this gate
    # (see exhibit-service/src/routes/wopi.ts). This exempts the editor's own
    # JS/CSS, not any exhibit content.
    auth_request off;
    allow all;

    # branding.js is OURS, mounted over Collabora's copy (see collabora.yml). Collabora serves
    # everything under /browser/ with `cache-control: max-age=11059200` -- correct for the rest
    # of that tree, whose paths are build-hashed and so change on every upgrade, and wrong for
    # the one file in it we edit in place. Its URL never changes, so without this an edit is
    # invisible for 128 days to any browser that has already loaded the editor once.
    #
    # Not hypothetical: bridge iterations were tested against a stale cached copy during
    # development and read as the code not working. The bundle keeps its long cache -- scoping
    # this to branding.js rather than relaxing the whole location matters, since bundle.js is
    # ~3.7MB on every cold load.
    #
    # Nested inside the ^~ block deliberately. A regex location at server scope would lose to
    # meet.conf's tenant regex (see the ^~ explanation on /exhibit-api/); nested, the outer
    # prefix has already won the match and this only picks the handler within it. proxy_* has
    # to be repeated because a nested location does not inherit the parent's proxy_pass.
    location ~ ^/browser/[^/]+/branding\.js$ {
        proxy_pass http://collabora:9980;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Replace rather than add: leaving Collabora's own header in place would send two
        # conflicting Cache-Control values and let the browser pick.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;

        auth_request off;
        allow all;
    }
}

# WOPI discovery + capabilities, hit by the client before it opens a document.
location ^~ /hosting/ {
    proxy_pass http://collabora:9980;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;   # see /browser/ above -- $host drops the port
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    auth_request off;
    allow all;
}

# The document session itself, which is a long-lived WebSocket. Same
# Upgrade/Connection/proxy_read_timeout treatment as /transcript-ws/panel
# above and for the same reason -- nginx's 60s default would silently drop an
# exhibit that sits open on screen during testimony.
#
# /cool/ carries both the WebSocket and Collabora's own callbacks; the
# WebSocket headers are harmless on the plain-HTTP requests that share the
# prefix, so one block covers both.
location ^~ /cool/ {
    proxy_pass http://collabora:9980;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;   # see /browser/ above -- $host drops the port
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    auth_request off;
    allow all;
}

# Deposition room links live under /r/<roomCode> (portal's buildJoinUrl,
# format.ts), not a bare /<roomCode> -- a bare top-level path collided with
# app routes: /verify (the portal's own magic-link landing route, reached
# through this exact domain since the portal is hosted at /portal/, not a
# separate origin) was being parsed as room name "verify" and joined as a
# conference instead of ever reaching the portal SPA, because the base
# jitsi-meet nginx config has exactly one bare-word location
# (`location ~ ^/([^/?&:'"]+)$ { try_files $uri @root_path; }`, unconditional)
# which matches ANY single path segment as "assume it's a room, serve the
# SPA shell and let client JS sort it out." Stock jitsi-meet does support
# a two-segment /tenant/room scheme that would have separated these
# cleanly (react/features/base/util/uri.ts's parseStandardURIString
# already treats the LAST path segment as the room and everything before
# it as an ignored `tenant` -- confirmed by reading actions.web.ts, where
# only `.room` is ever used for the actual join/validate calls, `.tenant`
# never is), but that codepath is gated behind base meet.conf's
# `{{ if $ENABLE_SUBDOMAINS }}` block, which staging doesn't set. Rather
# than flip ENABLE_SUBDOMAINS globally (touches BOSH/websocket path
# prefixing and other subdomain-mode behavior well beyond this one
# problem), this location alone gives /r/<anything> the same "serve the
# SPA shell, unrewritten URL" treatment that stock jitsi-meet's bare
# single-segment location already gives every top-level path -- reusing
# @root_path (defined earlier, unconditionally, in base meet.conf) rather
# than duplicating its `rewrite ^/(.*)$ / break;`. ^~ takes precedence over
# any regex location the same way the two proxy blocks below need it to,
# though it isn't load-bearing today since ENABLE_SUBDOMAINS is unset here;
# keeping it makes this location's behavior independent of that setting
# either way.
location ^~ /r/ {
    try_files $uri @root_path;
}

# Serves the portal SPA (../portal/) under /portal/ on this same
# domain/cert, same "avoid a second DNS record + Let's Encrypt cert"
# rationale as /exhibit-api/ and /identity-api/ above -- unlike those two
# though, this isn't an API being reverse-proxied, it's a static SPA build
# staged directly into this image's docroot (web-fortress/Dockerfile COPYs
# portal/dist/ to /usr/share/jitsi-meet/portal/, alongside the meet
# client's own assets). Built with VITE_BASE_PATH=/portal/ (vite.config.ts)
# and matching identity-service PORTAL_BASE_URL=.../portal/ (mailer.ts's
# buildPortalMagicLinkUrl) so its own emitted asset paths and magic-link
# URLs agree with where it's actually served from.
#
# try_files' final arg (/portal/index.html) is a URI, not a literal file
# path -- with `alias`, nginx re-enters location matching on it as an
# internal redirect (matches this same ^~ /portal/ location again, so it
# still resolves through the alias below), which is what makes SPA
# client-side routing (e.g. a hard refresh on /portal/agency) fall through
# to index.html instead of 404ing. Same ^~ precedence requirement as the
# two proxy blocks above (stock meet.conf's tenant-subdomain regex location
# would otherwise capture /portal/... first).
location ^~ /portal/ {
    alias /usr/share/jitsi-meet/portal/;
    try_files $uri $uri/ /portal/index.html;
}

# --- Password gate ---------------------------------------------------
# Gates the ENTIRE staging site (not just an API path like the two blocks
# above) behind a branded login page + signed cookie, checked via nginx's
# auth_request module (bundled in this image's nginx-extras package).
#
# HTTP Basic Auth was the obvious simpler alternative but was ruled out:
# Fortress also runs inside Electron, and Electron doesn't surface a
# native basic-auth prompt unless the app explicitly wires up its `login`
# event -- a custom HTML page works identically in a normal browser or
# Electron's renderer since it's just a form + cookie, no browser-chrome
# UI involved.
#
# satisfy/allow/deny/auth_request/error_page below are bare siblings at
# server scope (this file is `include`d directly inside both the :80 and
# :443 server{} blocks by web/rootfs/defaults/default) -- confirmed via a
# dedicated review pass that this really is inherited by every OTHER
# location already in meet.conf (the tenant-subdomain regex catch-all,
# /http-bind, /xmpp-websocket, the two blocks above), with no wrapping
# needed and no interference from the regex-location-precedence issue
# documented above: the tenant-regex locations do a bare `rewrite` with no
# `last`/`break`, which triggers an internal redirect BEFORE access-phase
# runs, so the gate ends up enforced exactly once against each request's
# final resolved location -- the correct place.
satisfy any;
allow 172.28.238.10/32;   # Jibri's pinned IP on meet.jitsi -- see staging-gate.yml.
                          # Jibri's internal headless Chrome loads the meeting page
                          # from this same public domain to record it (the FOR-59
                          # network-alias fix is what makes that resolve internally),
                          # so without this exemption the password gate would
                          # silently break recording.
deny all;
auth_request /gate-check;
error_page 401 = @gate_redirect;
# If staging-gate itself is down, degrade to (an also-unreachable, but at
# least not a raw 500) login page rather than a bare 500 on every gated
# path on the site.
error_page 500 502 503 504 = @gate_redirect;

location @gate_redirect {
    # Cookie, not a query-string append: $request_uri is the client's raw
    # request line and nginx does not URL-encode it when interpolated into
    # `return`, so a query string with its own unescaped `&` (e.g. a gated
    # API call) would get truncated/mangled. Cookie values don't have that
    # problem (RFC 6265 cookie-octet permits ?, &, =, / unescaped).
    add_header Set-Cookie "post_login_redirect=$request_uri; Path=/; Max-Age=300; HttpOnly; SameSite=Lax" always;
    # $scheme://$host/gate/, not a bare "/gate/" -- nginx listens
    # internally on 8443 (container port; HTTPS_PORT=443 is only the
    # host-side docker port mapping), and a bare-path return here had
    # nginx auto-constructing the Location header using that internal
    # listen port, producing "https://staging.fortressconferencing.com:8443/gate/"
    # -- a port that isn't even open on the security group. Real external
    # clients would hit a dead connection on the redirect. $host carries
    # no port, so this always resolves to the real public origin.
    return 302 $scheme://$host/gate/;
}

# No custom favicon exists yet -- this always 404s from the base image's
# own document root. Exempted from the gate entirely (not just left to be
# gated normally) because browsers request this automatically alongside
# every single page load, including the very first unauthenticated visit --
# so it races the real page's request to set the post_login_redirect cookie
# above. Set-Cookie overwrites, so whichever 401 response lands last wins,
# and when it's this one, login redirects the user straight into a
# pre-meeting screen for a "meeting" called favicon.ico instead of the
# welcome page (Jitsi's tenant-subdomain routing treats any bare
# single-segment path as a room name to join directly). Confirmed via a live
# test that this is exactly what was happening. Tried gating this normally
# but only skipping the cookie-set via an `if ($http_accept !~* "text/html")`
# check inside @gate_redirect first -- didn't work reliably (add_header
# still fired for non-html Accept headers, a known rough edge of `if` inside
# a named location reached via error_page), so exempting the request
# entirely instead, same pattern as /gate-check and /gate/ below.
#
# `return 204`, not `return 404` -- the base image's own default meet.conf
# has `error_page 404 /static/404.html;` at server level (inherited here
# same as everything else), and a bare 404 from this location triggers that
# mapping as a URI-based internal redirect (not a named-location one), which
# unlike error_page's `= @name` form DOES cause full phase reprocessing for
# the new URI -- re-entering the same satisfy/auth_request gate on
# /static/404.html and, once that 404s too, looping until nginx's internal
# redirect-cycle guard gives up and surfaces a bare 401 with no body. 204
# isn't mapped by any error_page directive here, so it skips all of that;
# browsers treat a 204 favicon response the same as a 404 (no icon shown).
location = /favicon.ico {
    auth_request off;
    allow all;
    return 204;
}

location = /gate-check {
    internal;
    auth_request off;
    # REQUIRED, not optional: `auth_request off` only neutralizes the
    # precontent-phase auth_request check -- it does NOT clear the
    # separately-inherited access-phase `deny all` above. auth_request's
    # own subrequest still runs the full phase engine (including access
    # phase) for ITS matched location, using the original client's
    # $remote_addr. Without this line, every real client outside the
    # allow CIDR gets a raw 403 here and never even reaches the login
    # page -- a total self-lockout, caught in review before it shipped.
    allow all;
    proxy_pass http://staging-gate:4200/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
}

# ^~ required for the same tenant-subdomain-regex-precedence reason as the
# two blocks above.
location ^~ /gate/ {
    auth_request off;
    allow all;   # same reasoning as /gate-check -- without this, real
                 # external clients can never load the login page itself.
    # Static proxy_pass target WITH a URI part ("/"), so nginx's automatic
    # prefix-substitution applies: /gate/login on the client side reaches
    # bare /login on staging-gate. The login form's action is therefore a
    # relative "login" (not "/login"), and staging-gate's own routes are
    # /, /login, /check -- no /gate prefix inside the app itself.
    proxy_pass http://staging-gate:4200/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Every reserved app path above (/exhibit-api/, /identity-api/, /r/,
# /portal/, /gate/) is a trailing-slash-anchored prefix location -- the
# bare word alone (no trailing slash, the obvious thing to type or link)
# is one character short of each prefix and doesn't match it, so it fell
# through to jitsi-meet's own single-segment location
# (`location ~ ^/([^/?&:'"]+)$ { try_files $uri @root_path; }`, base
# meet.conf, unconditional), which exists specifically to treat any
# otherwise-unmatched single path segment as a room name and join it --
# by design for real room names, but these reserved words must never be
# recognized as one. First caught on /verify (fixed at the source
# instead, see portal's buildJoinUrl/mailer.ts) and then /portal itself;
# rather than wait for a third one-off bug report per reserved word,
# these cover all of them at once. An unauthenticated hit still
# self-heals without this (401 on the room-catcher redirects to
# /gate/, which happens to restore the trailing slash) -- this closes
# the gap for an already-gated-in browser, which is the case that
# actually surfaced it.
#
# Five separate `location =` (exact-match) blocks, not one `location ~`
# regex alternation -- deliberately. Exact-match locations have
# unconditional top priority in nginx (checked before any prefix or
# regex location, in any order), so this doesn't depend on this file's
# include point (web/rootfs/defaults/meet.conf's `include
# .../nginx-custom/*.conf;`) staying textually before the room-catcher
# regex -- a `location ~` here would only win by matching first in file
# order among regex locations, which is correct today but silently
# fragile against a future reordering.
#
# auth_request off + allow all: matches /gate/'s own exemption below, on
# the same reasoning -- the redirect target for every word except /gate
# is itself still fully gated (its own location has no such exemption),
# so this only skips the check on the redirect hop itself, never on the
# actual content. $scheme://$host/word/, not a bare relative path -- same
# reasoning as @gate_redirect below (nginx's internal 8443 listen port
# would otherwise leak into the Location header).
location = /exhibit-api {
    auth_request off;
    allow all;
    return 301 $scheme://$host/exhibit-api/;
}

location = /identity-api {
    auth_request off;
    allow all;
    return 301 $scheme://$host/identity-api/;
}

location = /r {
    auth_request off;
    allow all;
    return 301 $scheme://$host/r/;
}

location = /portal {
    auth_request off;
    allow all;
    return 301 $scheme://$host/portal/;
}

location = /gate {
    auth_request off;
    allow all;
    return 301 $scheme://$host/gate/;
}
