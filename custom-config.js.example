// Fortress-specific additions to config.js.
//
// Upstream docker-jitsi-meet renders config.js from web/rootfs/defaults/{system,settings}-config.js
// and then appends ${CONFIG}/web/custom-config.js if present (see
// web/rootfs/etc/s6-overlay/scripts/config) -- this is the supported extension point for
// anything that isn't part of stock Jitsi Meet, like exhibitViewer below.
//
// This matters locally too: Fortress/webpack.config.js's dev-server proxy does NOT serve
// Codebase/Fortress/config.js -- it proxies /config.js straight through to this container's
// rendered one, so editing Fortress/config.js alone is a no-op. exhibitViewer has to be added
// here instead, or exhibit publishing fails client-side with "exhibitViewer.apiUrl is not
// configured" even though exhibit-service itself is up and healthy.
//
// Setup:
//   cp custom-config.js.example ${CONFIG:-~/.jitsi-meet-cfg}/web/custom-config.js
//   docker compose --env-file .env -f docker-compose.yml restart web
//
// (restart, not up -d -- compose won't detect a change to a file mounted from the host)

config.exhibitViewer = {
    enabled: true,
    apiUrl: 'https://localhost:4000',
    // -1 disables the client-side size check entirely (see validateExhibitFile,
    // react/features/exhibit-viewer/functions.ts) -- without this override it defaults to
    // MAX_FILE_SIZE (50MB, file-sharing/constants.ts). exhibit-service's own MAX_UPLOAD_BYTES
    // (5GiB, S3's own single-PUT ceiling) is the real remaining limit either way.
    maxFileSize: -1
};

// Fortress identity service (FOR-50) -- same reasoning as exhibitViewer above:
// editing Fortress/config.js alone is a no-op locally, so this has to live here.
config.identityService = {
    apiUrl: 'http://127.0.0.1:4300',
    enabled: true
};
